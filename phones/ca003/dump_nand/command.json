{
 "model": "ca003",
 "command": "dump_nand",
 "title": "Dump the whole 512 MiB NAND, data and spare, in one run",
 "push": [
  "NAND01.MHT",
  "NAND02.DOC"
 ],
 "open_order": [
  "NAND01   -- plants the payload. Nothing visible happens; that is correct.",
  "NAND02   -- starts the dump. Close NAND01 before opening it."
 ],
 "capture": {
  "start_marker": "CA003 NAND BEGIN",
  "stop_marker": "CA003 OOB   END.",
  "quiet_stop": 90
 },
 "reconstruct": {
  "kind": "indexed",
  "units": 262144,
  "fail_seq": 5,
  "wire_bytes_per_unit": 2144,
  "outputs": [
   {
    "file": "nand.bin",
    "seq": 1,
    "stride": 2048,
    "take": [
     0,
     2048
    ],
    "coverage": true
   },
   {
    "file": "oob.bin",
    "seq": 4,
    "stride": 64,
    "take": [
     0,
     64
    ]
   }
  ],
  "skip_record": {
   "seq": 1,
   "head": "EEEEEEEE",
   "tail": "EEEEEEEE"
  },
  "expect": {
   "seq": 1,
   "index": 0,
   "at": 0,
   "bytes": "1d1d1d1d3410d773",
   "label": "page 0 is the MIBIB header, so addressing is ABSOLUTE"
  }
 }
}
